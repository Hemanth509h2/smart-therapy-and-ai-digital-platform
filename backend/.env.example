# Database
DATABASE_URL="postgresql://user:password@localhost:5432/staad?schema=public"

# Firebase Admin (for server-side auth)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN="your-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# Approved template names (needed to message patients outside the 24h window)
WHATSAPP_INVITE_TEMPLATE=""     # body vars: {{1}} patient, {{2}} therapist, {{3}} link
WHATSAPP_SCHEDULED_TEMPLATE=""  # body vars: {{1}} patient, {{2}} therapist, {{3}} date/time
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Optional: the session link is POSTed here first; if it errors, the Cloud API sends it
WHATSAPP_LINK_WEBHOOK_URL=""
WHATSAPP_LINK_WEBHOOK_SECRET=""  # sent as "Authorization: Bearer <secret>"

# App URL (for generating join links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: OpenRouter for AI reports
OPENROUTER_API_KEY="your-openrouter-key"
# HMAC secret for STT WebSocket tokens (generate with: openssl rand -hex 32).
# An external STT relay must be configured with the same secret.
STT_TOKEN_SECRET="replace-with-a-long-random-secret"
