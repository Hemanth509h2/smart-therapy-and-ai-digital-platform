# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# server.js loads it via @next/env, so restart `npm run dev` after any change.

# ---- Required for sign-up / onboarding / anything that touches Postgres ----
# Any Postgres 15+ with the pgvector extension (Neon, Supabase, or local).
# After setting it: npx prisma db push
DATABASE_URL=

# ---- Required for role custom claims (onboarding still works without it,
#      but Firestore rules cannot tell a therapist from a client) ----
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=staad-edtech
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@staad-edtech.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Hosts that cap env values at 1000 chars (e.g. Catalyst): leave FIREBASE_PRIVATE_KEY
# unset and split the same string across FIREBASE_PRIVATE_KEY_1, FIREBASE_PRIVATE_KEY_2, ...

# ---- Feature-specific. Leave blank until you need that feature. ----
# Video sessions
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://...

# AI insights / RAG embeddings
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_COPILOT_MODEL=
OPENROUTER_SITE_URL=

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# Signs the tokens /api/stt-token hands the browser for the STT relay.
# Must match STT_TOKEN_SECRET in ai/.env.
STT_TOKEN_SECRET=
# STT relay URL, only used by the admin health check.
STT_RELAY_URL=http://localhost:4100

# CORS: comma-separated frontend origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:3000

# Invite emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp notifications (invites + session scheduled)
# WHATSAPP_PROVIDER=twilio|bot. If unset: Twilio when its creds exist, else the bot.
WHATSAPP_PROVIDER=
# Twilio (works on Vercel). Testing: use Sandbox number +14155238886;
# recipients must first send "join <code>" to it on WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Self-hosted Baileys bot (whatsapp-bot/) - needs an always-on server, not Vercel.
WHATSAPP_BOT_URL=
WHATSAPP_BOT_SECRET=
# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names (needed to message patients outside the 24h window)
WHATSAPP_INVITE_TEMPLATE=     # body vars: {{1}} patient, {{2}} therapist, {{3}} link
WHATSAPP_SCHEDULED_TEMPLATE=  # body vars: {{1}} patient, {{2}} therapist, {{3}} date/time
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional: the session link is POSTed here first; if it errors, the Cloud API sends it
WHATSAPP_LINK_WEBHOOK_URL=
WHATSAPP_LINK_WEBHOOK_SECRET=  # sent as "Authorization: Bearer <secret>"
# Public URL of the frontend, used in links sent to clients (e.g. https://app.staad.in).
# If blank, the Origin of the browser request is used.
APP_URL=

# Cashfree payments (used by the hidden /payment-test page for now).
# Dashboard > Developers > API Keys. CASHFREE_ENV=sandbox|production (default sandbox).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Webhook: register https://<backend>/api/payments/cashfree/webhook in
# Dashboard > Developers > Webhooks, or set it here to send it per order.
CASHFREE_NOTIFY_URL=

# Shared secret for /api/automation/* (the n8n workflows send it as the x-api-key header).
# Generate one with: openssl rand -hex 32
AUTOMATION_API_KEY=

# Scheduled jobs + admin seeding
CRON_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# DEV ONLY: set to 'true' to skip Firebase token verification on API routes
# (identity is taken from the frontend's x-dev-uid header). Use when the local
# network blocks Node's access to Google APIs. NEVER true in production.
AUTH_DISABLED=false
