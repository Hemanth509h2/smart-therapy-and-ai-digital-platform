# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# server.js loads it via @next/env, so restart `npm run dev` after any change.

# ---- Required for sign-up / onboarding / anything that touches Postgres ----
# Any Postgres 15+ with the pgvector extension (Neon, Supabase, or local).
# After setting it: npx prisma db push
DATABASE_URL=

# ---- Required for role custom claims (onboarding still works without it,
#      but Firestore rules cannot tell a therapist from a client) ----
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=staad-edtech
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@staad-edtech.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Feature-specific. Leave blank until you need that feature. ----
# Video sessions
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://...

# AI insights / RAG embeddings
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_COPILOT_MODEL=
OPENROUTER_SITE_URL=

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# Used by the Vercel app to sign WebSocket tokens for the relay.
STT_TOKEN_SECRET=
# The URL of the deployed relay (e.g., https://staad-relay.fly.dev)
NEXT_PUBLIC_STT_RELAY_URL=

# Invite emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp notifications (invites + session scheduled)
# WHATSAPP_PROVIDER=twilio|bot. If unset: Twilio when its creds exist, else the bot.
WHATSAPP_PROVIDER=
# Twilio (works on Vercel). Testing: use Sandbox number +14155238886;
# recipients must first send "join <code>" to it on WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Self-hosted Baileys bot (whatsapp-bot/) - needs an always-on server, not Vercel.
WHATSAPP_BOT_URL=
WHATSAPP_BOT_SECRET=

# Scheduled jobs + admin seeding
CRON_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
