# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# server.js loads it via @next/env, so restart `npm run dev` after any change.

# ---- Required for sign-up / onboarding / anything that touches Postgres ----
# Two Postgres 15+ databases, both with the pgvector extension (Neon, Supabase,
# or local). See src/lib/core/db.ts for which tables live where.
#   DATABASE_URL   app database: therapist/admin profiles, plans, payments, settings
#   DATABASE_URL_2 HIPAA database: users, clients, sessions, notes, reports.
#                  Must be a HIPAA-covered database (signed BAA) in production.
# After setting them:
#   npx prisma db push                                    (HIPAA database)
#   npx prisma db push --schema prisma/app/schema.prisma  (app database)
DATABASE_URL=
DATABASE_URL_2=

# ---- Required for role custom claims (onboarding still works without it,
#      but Firestore rules cannot tell a therapist from a client) ----
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=staad-edtech
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@staad-edtech.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Hosts that cap env values at 1000 chars (e.g. Catalyst): leave FIREBASE_PRIVATE_KEY
# unset and split the same string across FIREBASE_PRIVATE_KEY_1, FIREBASE_PRIVATE_KEY_2, ...

# ---- Feature-specific. Leave blank until you need that feature. ----
# Video sessions
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://...

# AI service (ai/). All AI work runs there: speech-to-text, the call-plan agent,
# AI insights and session reports. The AI keys (OpenRouter, NVIDIA, Sarvam) and
# model choices go in ai/.env, not here.
# Signs the tokens for the AI service: the browser's (STT, call plan) and this
# backend's own calls for insights and reports. Must match STT_TOKEN_SECRET in ai/.env.
STT_TOKEN_SECRET=
# Where this backend reaches the AI service: AI insights, session reports and the
# admin health check. On a server, the AI service's address.
STT_RELAY_URL=http://localhost:4100

# CORS: comma-separated frontend origins allowed to call the API from a browser.
# Admin > Usage also asks the first non-localhost one for the frontend
# server's CPU/memory (/server-stats).
ALLOWED_ORIGINS=http://localhost:3000

# Invite emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL of the frontend, used in links in emails (e.g. https://app.staad.in).
# If blank, the Origin of the browser request is used.
APP_URL=
# Lets Admin > Usage read the frontend server's CPU/memory (/server-stats).
# Generate with `openssl rand -hex 32`; set the SAME value on the frontend.
SERVER_STATS_SECRET=

# Cashfree payments (used by the hidden /payment-test page for now).
# Dashboard > Developers > API Keys. CASHFREE_ENV=sandbox|production (default sandbox).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Webhook: register https://<backend>/api/payments/cashfree/webhook in
# Dashboard > Developers > Webhooks, or set it here to send it per order.
CASHFREE_NOTIFY_URL=

# Shared secret for /api/automation/* (the n8n workflows send it as the x-api-key header).
# Generate one with: openssl rand -hex 32
AUTOMATION_API_KEY=
# n8n's address, for the admin health check (e.g. http://localhost:5678).
N8N_URL=

# Scheduled jobs + admin seeding
CRON_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# DEV ONLY: set to 'true' to skip Firebase token verification on API routes
# (identity is taken from the frontend's x-dev-uid header). Use when the local
# network blocks Node's access to Google APIs. NEVER true in production.
AUTH_DISABLED=false
