# Database
DATABASE_URL="postgresql://user:password@localhost:5432/staad?schema=public"

# Firebase Admin (for server-side auth)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Bot (self-hosted Baileys)
WHATSAPP_BOT_URL="http://localhost:3001"
WHATSAPP_BOT_SECRET="your-bot-secret"

# n8n Integration
N8N_SESSION_COMPLETED_WEBHOOK_URL="https://your-n8n-domain.com/webhook/session-completed"

# App URL (for generating join links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: OpenRouter for AI reports
OPENROUTER_API_KEY="your-openrouter-key"