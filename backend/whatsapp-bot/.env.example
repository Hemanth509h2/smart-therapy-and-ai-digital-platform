# Port (Fly sets PORT=8080 via fly.toml; locally falls back to BOT_PORT).
BOT_PORT=4001

# Shared secret the main app must send as the x-bot-secret header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_SECRET=

# Where the WhatsApp session is stored. On Fly this is the mounted volume.
AUTH_DIR=./auth_info

# Optional headless pairing: bot's number with country code (e.g. 919876543210).
# When set, an 8-char pairing code is logged instead of a QR.
PAIRING_NUMBER=

# Sarvam STT proxy
SARVAM_API_KEY=
# Must equal STT_TOKEN_SECRET in the Next.js app (signs short-lived WS tokens).
STT_TOKEN_SECRET=
# Comma-separated browser origins allowed to open the STT socket (blank = any).
ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=warn
