{
  "name": "staad-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "predev": "npm run db:generate",
    "dev": "node server.js",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "node server.js --prod",
    "lint": "next lint",
    "test:pgvector": "tsx scripts/test-pgvector.ts",
    "setup:pgvector": "tsx scripts/setup-pgvector.ts",
    "test:nvidia": "tsx scripts/test-nvidia.ts",
    "test:transcription": "tsx scripts/test-transcription.ts",
    "test:retrieval": "tsx scripts/test-retrieval.ts",
    "test:ingest": "tsx scripts/test-ingest.ts",
    "test:analysis": "tsx scripts/test-analysis.ts",
    "test:e2e": "tsx scripts/test-e2e-rag.ts",
    "seed:admin": "node --env-file=.env scripts/seed-admin.cjs",
    "seed:plans": "node --env-file=.env scripts/seed-plans.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project staad-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only firestore --project staad-rules-test",
    "rules:backfill-claims": "node --env-file=.env scripts/backfill-role-claims.mjs",
    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@deepgram/sdk": "^3.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.11",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.39.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "livekit-client": "^2.19.0",
    "livekit-server-sdk": "^2.15.3",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next": "^14.2.35",
    "nodemailer": "^8.0.11",
    "openai": "^6.41.0",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-query": "^1.2.8",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "firebase-tools": "^15.28.1",
    "marked": "^18.0.4",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.0": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.0": true
  }
}
