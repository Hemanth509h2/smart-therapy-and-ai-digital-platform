# Copy to `.env` and fill in. server.py loads it on start; restart after any change.

PORT=4100

# Sarvam API key — attached to the upstream WebSocket as a header, never sent to browsers.
SARVAM_API_KEY=
# Optional override of the upstream endpoint (tests point this at a local mock).
SARVAM_WS_URL=

# OpenRouter key for every AI feature: call-plan agent, AI insights ("Analyse"),
# safety scan and session reports. Unset = all of them off.
OPENROUTER_API_KEY=
# Optional model per feature. Unset = the free default in openrouter.py
# (nvidia/nemotron-3-ultra-550b-a55b:free, ~30s a call).
# AI insights + safety scan:
OPENROUTER_COPILOT_MODEL=
# Session reports:
OPENROUTER_MODEL=
# Call-plan agent (falls back to OPENROUTER_COPILOT_MODEL):
OPENROUTER_AGENT_MODEL=
OPENROUTER_SITE_URL=

# The backend's two Postgres databases (same values as backend-express/.env), with
# pgvector. The call-plan agent searches the module reports (module_report_chunks,
# app database DATABASE_URL) and AI insights search the therapist's study
# material (document_chunks, HIPAA database DATABASE_URL_2); the scripts in
# scripts/ fill both. Without a URL its search is off; without NVIDIA_API_KEY
# the module-report search falls back to keywords and the study-material search
# is off.
DATABASE_URL=
DATABASE_URL_2=
NVIDIA_API_KEY=

# Must be the SAME value as STT_TOKEN_SECRET in backend-express/.env (the backend mints
# tokens for STT, the call-plan agent and its own /internal calls; this service
# verifies them). Unset = every connection is refused.
STT_TOKEN_SECRET=

# Local development only: AI_DEV_NO_AUTH=true lets connections in without a
# token when STT_TOKEN_SECRET is unset. Ignored when NODE_ENV=production.
AI_DEV_NO_AUTH=

# Comma-separated browser origins allowed to connect, e.g. https://app.staad.in.
# REQUIRED in every deployment: unset allows only http://localhost:3000.
ALLOWED_ORIGINS=

# Set to "production" in deployments (the Dockerfile does). The name matches
# the backend's.
NODE_ENV=
