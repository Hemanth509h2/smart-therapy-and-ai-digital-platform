# Copy to `.env` and fill in. server.py loads it on start; restart after any change.

PORT=4100

# Sarvam API key — attached to the upstream WebSocket as a header, never sent to browsers.
SARVAM_API_KEY=
# Optional override of the upstream endpoint (tests point this at a local mock).
SARVAM_WS_URL=

# OpenRouter key for the call-plan agent (same account as backend/.env). Unset = agent off.
OPENROUTER_API_KEY=
# Optional model override; falls back to OPENROUTER_COPILOT_MODEL, then the free default.
OPENROUTER_AGENT_MODEL=
OPENROUTER_COPILOT_MODEL=
OPENROUTER_SITE_URL=

# The call-plan agent searches the STAAD module reports (module_report_chunks) in the
# backend's database. Use the same values as backend/.env. Without DATABASE_URL the
# agent plans from the module list alone; without NVIDIA_API_KEY it searches by keyword.
DATABASE_URL=
NVIDIA_API_KEY=

# Must be the SAME value as STT_TOKEN_SECRET in backend/.env (the backend mints
# tokens for STT and the call-plan agent, this service verifies them).
# Unset = tokenless in dev, refuse-all in production.
STT_TOKEN_SECRET=

# Optional comma-separated browser origins allowed to connect, e.g. https://app.staad.in
ALLOWED_ORIGINS=

# Set to "production" in deployments (the Dockerfile does): refuses all
# connections if STT_TOKEN_SECRET is missing. The name matches the backend's.
NODE_ENV=
