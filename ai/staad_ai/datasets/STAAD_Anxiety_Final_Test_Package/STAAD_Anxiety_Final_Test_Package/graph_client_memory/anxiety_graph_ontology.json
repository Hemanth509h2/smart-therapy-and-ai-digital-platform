  "rules": [
    "Client-specific information is separate from general Anxiety RAG knowledge.",
    "Do not infer causation merely because a trigger/context and symptom are linked.",
    "Observed, reported, inferred and summarized information must be distinguishable.",
    "Patterns require provenance and should not be treated as diagnoses.",
    "Risk events use the approved STAAD safety workflow.",
    "Medication decisions are not generated by the graph."
  ],
  "testing_status": "schema_and_synthetic_demo_only",
  "production_eligible": false,
  "pattern_rule": "A longitudinal pattern must not be established from one synthetic session. Require repeated source-linked events, transparent support counts, and review status.",
  "source_rule": "Keep general clinical knowledge in the Knowledge Memory. Client graph nodes/edges must be derived only from authorized client/session sources in production.",
  "synthetic_demo_warning": "All client/session/example graph facts in this package are synthetic. Canonical concept nodes are terminology concepts, not client facts."
}