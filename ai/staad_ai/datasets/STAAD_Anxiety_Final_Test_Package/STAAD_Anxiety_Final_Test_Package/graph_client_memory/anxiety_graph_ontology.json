{
  "purpose": "STAAD anxiety-specific client/graph memory package. It extends the generic client-memory design with anxiety-relevant context, trigger, avoidance and risk relationships.",
  "entity_types": [
    {
      "entity_type": "Client",
      "description": "Internal client identifier; keep identifying information separate."
    },
    {
      "entity_type": "Condition",
      "description": "Documented condition or working clinical status."
    },
    {
      "entity_type": "AnxietyPresentation",
      "description": "GAD, social anxiety, panic disorder, phobia-related or other approved presentation."
    },
    {
      "entity_type": "Symptom",
      "description": "Documented/reported anxiety-related symptom or difficulty."
    },
    {
      "entity_type": "Context",
      "description": "Situation in which an observation occurs, such as school, work, social or performance context."
    },
    {
      "entity_type": "Trigger",
      "description": "Documented antecedent associated with anxiety; do not assume causality."
    },
    {
      "entity_type": "FunctionalImpact",
      "description": "Documented impact on academic, occupational, social or daily functioning."
    },
    {
      "entity_type": "Goal",
      "description": "Client-specific support or therapy goal."
    },
    {
      "entity_type": "Session",
      "description": "A session with timestamp, module and source reference."
    },
    {
      "entity_type": "Observation",
      "description": "Directly documented observation."
    },
    {
      "entity_type": "ReportedExperience",
      "description": "Client/parent/teacher/professional report, according to workflow."
    },
    {
      "entity_type": "Intervention",
      "description": "Clinician-guided strategy or intervention used."
    },
    {
      "entity_type": "Activity",
      "description": "Specific module/exercise/task used in a session."
    },
    {
      "entity_type": "Response",
      "description": "Documented client response to an intervention/activity."
    },
    {
      "entity_type": "AvoidanceBehaviour",
      "description": "Documented avoidance or reduced participation."
    },
    {
      "entity_type": "ProgressMeasure",
      "description": "Validated or approved measure/indicator."
    },
    {
      "entity_type": "Pattern",
      "description": "Repeated or clinically meaningful pattern with provenance."
    },
    {
      "entity_type": "RiskEvent",
      "description": "Documented safety/risk event requiring approved workflow."
    },
    {
      "entity_type": "Accommodation",
      "description": "Documented support/accommodation."
    },
    {
      "entity_type": "Preference",
      "description": "Documented delivery preference."
    },
    {
      "entity_type": "SourceRecord",
      "description": "Pointer to original transcript, note, event or assessment."
    }
  ],
