# Frontend env — only NEXT_PUBLIC_* vars (shipped to the browser).
NEXT_PUBLIC_LIVEKIT_URL=wss://...
NEXT_PUBLIC_STT_RELAY_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STT_RELAY_URL=http://localhost:4000
NEXT_PUBLIC_STT_TEST_MODE=false

# Firebase web config (public by design — safe to ship to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
