# =============================================================================
# STAAD - cloud server settings for docker-compose.yml and the Caddyfile
# =============================================================================
#
# Copy this file to .env (next to docker-compose.yml) and fill it in.
# Each service keeps its own settings in backend/.env, frontend/.env, ai/.env
# and feedback-board/.env; the values here are only the server-wide ones.
# =============================================================================


# ---- Domains ----------------------------------------------------------------
# Point each one (DNS "A" record) to this server's public IP before starting.

# Main app: website, API and speech-to-text, all on one domain.
APP_DOMAIN=app.example.com

# Feedback board.
FEEDBACK_DOMAIN=feedback.example.com

# n8n editor and webhooks.
N8N_DOMAIN=n8n.example.com


# ---- HTTPS ------------------------------------------------------------------
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com


# ---- Feedback board database ------------------------------------------------
# Password for the feedback board's own Postgres container. Generate one with:
#   openssl rand -hex 24
# Set it before the first start: Postgres only reads it when the database is
# created.
FEEDBACK_DB_PASSWORD=


# ---- Optional ---------------------------------------------------------------
# Cloudflare Turnstile site key for the feedback board CAPTCHA (public value).
# The matching TURNSTILE_SECRET_KEY goes in feedback-board/.env.
TURNSTILE_SITE_KEY=
