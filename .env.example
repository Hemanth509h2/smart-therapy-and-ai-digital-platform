# =============================================================================
# STAAD - settings for docker-compose.yml
# =============================================================================
#
# Optional. Copy this file to .env (next to docker-compose.yml) to change the
# addresses. Without it, everything runs on localhost.
# Each service keeps its own settings in backend-express/.env, frontend/.env and
# ai/.env; the values here are only the shared addresses.
# =============================================================================

# The website, as people open it in the browser. Used for links in emails and
# as the only origin allowed to call the API and the AI service.
WEBSITE_URL=http://localhost:3000

# The backend API, as the browser reaches it.
API_URL=http://localhost:4000

# The AI service (speech-to-text, call plan), as the browser reaches it.
AI_URL=http://localhost:4100

# API_URL and AI_URL are built into the website: after changing them, rebuild
# with: docker compose up -d --build frontend
