# Dedicated feedback database. Must NOT be the main app's database or credentials.
DATABASE_URL=postgres://feedback:feedback@localhost:5433/feedback

# Secret for HMAC voter/reporter keys. Rotating resets vote de-duplication.
# Generate: openssl rand -hex 32
HMAC_SECRET=change-me

# Admin moderation queue login
ADMIN_PASSWORD=change-me

# Cloudflare Turnstile (optional in dev: CAPTCHA is skipped when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Extra comma-separated blocked words (on top of email/phone patterns)
BLOCKLIST=

# Auto-hide content once it has this many open reports
AUTO_HIDE_REPORTS=3

# Public URL encoded in the /present QR code (defaults to the current site)
NEXT_PUBLIC_PUBLIC_URL=
