    {
      "parameters": {
        "toolDescription": "Get the doctor's profile, today's sessions, the next 7 days of scheduled sessions, and headline counts (clients, scheduled/completed/cancelled sessions). Use for general questions like 'what's my day look like' or 'how many clients do I have'.",
        "method": "GET",
        "url": "https://YOUR-BACKEND-URL/api/automation/doctor/overview",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
