    {
      "parameters": {
        "toolDescription": "List the doctor's sessions between two dates (inclusive). Returns time and client name for each. Use for 'today', 'tomorrow', 'this week', 'last Monday', etc. Defaults to today only.",
        "method": "GET",
        "url": "https://YOUR-BACKEND-URL/api/automation/doctor/schedule",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "phone",
              "valueProvider": "fieldValue",
              "value": "={{ $('WhatsApp Trigger').item.json.messages[0].from }}"
            },
            {
              "name": "from",
              "description": "Start date, YYYY-MM-DD, India time. Defaults to today.",
              "valueProvider": "modelOptional"
            },
            {
              "name": "to",
              "description": "End date, YYYY-MM-DD, India time. Defaults to the start date. At most 31 days after from.",
              "valueProvider": "modelOptional"
            },
            {
              "name": "status",
              "description": "Optional comma-separated filter: SCHEDULED, ACTIVE, COMPLETED, CANCELLED. Default excludes cancelled.",
              "valueProvider": "modelOptional"
            }
          ]
        }
      },
      "id": "2f51723d-5aed-4a6d-a621-8b7f5d12bdfa",
