# =============================================================================
# STAAD - Caddy reverse proxy (HTTPS front door for the cloud server)
# =============================================================================
#
# What this does:
#   Caddy is the only container open to the internet (ports 80 and 443).
#   It gets free HTTPS certificates from Let's Encrypt automatically and
#   renews them, then forwards each request to the right container.
#
# The domains come from the .env file next to docker-compose.yml:
#   APP_DOMAIN       the main app: website + API + speech-to-text, one domain
#   FEEDBACK_DOMAIN  the feedback board
#   N8N_DOMAIN       the n8n editor and webhooks
#
# Before starting, every domain must point (DNS "A" record) to this server's
# public IP address, or Let's Encrypt cannot issue the certificate.
# =============================================================================


# -----------------------------------------------------------------------------
# Global settings
# -----------------------------------------------------------------------------
{
	# Let's Encrypt sends certificate expiry warnings to this address.
	email {$ACME_EMAIL}
}


# -----------------------------------------------------------------------------
# Main app: https://APP_DOMAIN
#
# One domain for everything the browser uses, so the browser only talks to its
# own origin (no CORS problems, one certificate):
#   /sarvam-stream, /api/sarvam-stream   speech-to-text WebSocket  -> ai
#   /call-plan                           call-plan agent WebSocket -> ai
#   /api/...                             backend API               -> backend
#   everything else                      website                   -> frontend
# -----------------------------------------------------------------------------
{$APP_DOMAIN} {
	# Speech-to-text WebSocket. Must come before /api/* because one of its
	# paths starts with /api/. Caddy passes WebSocket connections through as-is.
	handle /sarvam-stream* {
		reverse_proxy ai:4100
	}
	handle /api/sarvam-stream* {
		reverse_proxy ai:4100
	}
	# Call-plan AI agent WebSocket (AI Notes popup).
	handle /call-plan* {
		reverse_proxy ai:4100
	}

	# Backend API.
	handle /api/* {
		encode zstd gzip
		reverse_proxy backend:4000
	}

	# Website (all other pages, scripts and images).
	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}
}


# -----------------------------------------------------------------------------
# Feedback board: https://FEEDBACK_DOMAIN
# -----------------------------------------------------------------------------
{$FEEDBACK_DOMAIN} {
	encode zstd gzip
	reverse_proxy feedback-board:3100
}


# -----------------------------------------------------------------------------
# n8n: https://N8N_DOMAIN (editor and webhooks)
# -----------------------------------------------------------------------------
{$N8N_DOMAIN} {
	reverse_proxy n8n:5678
}
