# Port (Render sets PORT automatically; locally falls back to BOT_PORT).
BOT_PORT=4001

# Shared secret the main app must send as the x-bot-secret header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_SECRET=

# Where the WhatsApp session is stored. On Render, point this at the persistent disk (e.g. /var/data/auth_info).
AUTH_DIR=./auth_info

# Optional headless pairing: bot's number with country code (e.g. 919876543210).
# When set, an 8-char pairing code is logged instead of a QR.
PAIRING_NUMBER=

LOG_LEVEL=warn
