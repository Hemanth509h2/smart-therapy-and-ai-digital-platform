rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Staad Firestore security rules
//
// REPLACES a catch-all `match /{document=**} { allow read, write: if
// request.auth != null; }` under which ANY authenticated account could read and
// write EVERY document — every patient's transcript, attention score, consent
// state and therapist notes.
//
// ── The entitlement model ───────────────────────────────────────────────────
// Firestore does not know who is entitled to a session. That lives in Postgres
// (`Session.therapistId -> ProfileTherapist.userId`, `Session.clientId ->
// ProfileClient.userId`) and rules cannot query it.
//
// So entitlement is MIRRORED into Firestore as `liveSessions/{id}.allowedUids`,
// written ONLY by the server through the Admin SDK (which bypasses rules) in
// src/lib/session-provisioning.ts. Every session-scoped rule below authorises
// against that one field.
//
// This is why clients may not create or delete `liveSessions`, and may never
// modify `allowedUids`: if a client could write it, it would be self-issued
// authorisation and the whole model would be circular.
//
// ── Roles ───────────────────────────────────────────────────────────────────
// User roles also live in Postgres. They reach rules as a Firebase custom claim
// (`request.auth.token.role`), minted server-side at profile creation and by
// scripts/backfill-role-claims.mjs. A claim is only trustworthy because the
// client cannot set it.
//
// NOTE: claims land in the ID token, so a user must refresh their token (a
// re-login, or an hour's expiry) before a newly minted claim is visible.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function liveSessionData(sid) {
      return get(/databases/$(database)/documents/liveSessions/$(sid)).data;
    }

    function liveSessionExists(sid) {
      return exists(/databases/$(database)/documents/liveSessions/$(sid));
    }

    // The single authorisation predicate for everything session-scoped.
    // Fails closed: no liveSessions doc, or no allowedUids on it, means no access.
    function isSessionMember(sid) {
      return signedIn()
        && liveSessionExists(sid)
        && liveSessionData(sid).keys().hasAny(['allowedUids'])
        && request.auth.uid in liveSessionData(sid).allowedUids;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.get('role', '') == role;
    }

    // The professional side of a session: the therapist, or an admin in their
    // private "Try module" room. Everyone else in allowedUids (the client, or a
    // guest's anonymous uid) is the client side.
    function isProfessional() {
      return hasRole('THERAPIST') || hasRole('ADMIN');
    }

    // Top-level fields this write changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A list field may only grow: every existing entry must still be there.
    // Deletion (the retention job) runs server-side through the Admin SDK,
    // which bypasses these rules.
    function appendOnly(field) {
      return !(field in changedKeys())
        || (request.resource.data.get(field, []) is list
            && request.resource.data.get(field, []).hasAll(resource.data.get(field, [])));
    }

    // aiConsent: each side may set only its OWN flag, to a boolean. The server
    // gates transcription and AI calls on both flags, so one participant must
    // never be able to consent for the other.
    function consentKey() {
      return isProfessional() ? 'therapist' : 'client';
    }
    function ownConsentOnly() {
      return !('aiConsent' in changedKeys())
        || (request.resource.data.aiConsent is map
            && request.resource.data.aiConsent
                 .diff(resource.data.get('aiConsent', {}))
                 .affectedKeys().hasOnly([consentKey()])
            && request.resource.data.aiConsent.get(consentKey(), null) is bool);
    }

    // liveSessions: a participant may change only their own entry in
    // `participants`, with a valid shape and a role that matches their claim.
    function ownParticipantOnly() {
      return !('participants' in changedKeys())
        || (request.resource.data.participants is map
            && request.resource.data.participants
                 .diff(resource.data.get('participants', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
            && validParticipant(request.resource.data.participants.get(request.auth.uid, null)));
    }
    function validParticipant(p) {
      return p is map
        && p.keys().hasOnly(['uid', 'name', 'role', 'isOnline', 'lastSeen'])
        && p.get('uid', request.auth.uid) == request.auth.uid
        && p.get('name', '') is string && p.get('name', '').size() <= 120
        && p.get('role', 'client') in ['therapist', 'client']
        && (p.get('role', 'client') == 'client' || isProfessional())
        && p.get('isOnline', false) is bool
        && (p.get('lastSeen', null) == null || (p.lastSeen is string && p.lastSeen.size() <= 40));
    }
    // liveSessions: types and sizes of the other fields browsers write.
    function validLiveFields() {
      let d = request.resource.data;
      return (!('activeModuleId' in changedKeys())
               || d.activeModuleId == null
               || (d.activeModuleId is string && d.activeModuleId.size() <= 100))
        && (!('therapistControl' in changedKeys()) || d.therapistControl is bool)
        && (!('whiteboard' in changedKeys())
            || (d.whiteboard is map
                && d.whiteboard.keys().hasOnly(['active', 'shared'])
                && d.whiteboard.get('active', false) is bool
                && d.whiteboard.get('shared', false) is bool))
        && (!('status' in changedKeys()) || d.status == 'ended')
        && (!('lastReaction' in changedKeys())
            || (d.lastReaction is map
                && d.lastReaction.keys().hasOnly(['emoji', 'timestamp'])
                && d.lastReaction.get('emoji', '') is string && d.lastReaction.get('emoji', '').size() <= 16
                && d.lastReaction.get('timestamp', '') is string && d.lastReaction.get('timestamp', '').size() <= 40))
        && (!('moduleState' in changedKeys()) || d.moduleState is map)
        && (!('timestamps' in changedKeys()) || d.timestamps is map);
    }

    // ── liveSessions/{sessionId} ────────────────────────────────────────────
    // Real-time room state: participants, active module, module state,
    // whiteboard flags, reactions. Both participants read and write it
    // constantly during a call.
    //
    // Field-level limits. Written from the browser (see frontend/src):
    //   both sides  moduleState (therapy modules), lastReaction (ReactionOverlay),
    //               their own participants entry (session page), timestamps
    //   therapist   activeModuleId, whiteboard, therapistControl, status:'ended'
    //               (session page; all gated on isTherapist there)
    // allowedUids and everything else are server-only (session-provisioning.ts).
    //
    // Provisioned server-side. A client that could create this document could
    // mint its own `allowedUids` and thereby grant itself access to any
    // session id it can guess.
    match /liveSessions/{sessionId} {
      allow get, list: if isSessionMember(sessionId);

      allow create: if false;
      allow delete: if false;

      // Members may update room state, but never the entitlement itself.
      allow update: if isSessionMember(sessionId)
        && request.resource.data.allowedUids == resource.data.allowedUids
        && changedKeys().hasOnly([
             'activeModuleId', 'therapistControl', 'whiteboard', 'status',
             'participants', 'lastReaction', 'moduleState', 'timestamps'])
        && (isProfessional()
            || !changedKeys().hasAny(['activeModuleId', 'therapistControl', 'whiteboard', 'status']))
        && ownParticipantOnly()
        && validLiveFields();
    }

    // ── sessions/{sessionId} ────────────────────────────────────────────────
    // The durable session record: aiConsent, transcript[], aiInsight,
    // moduleEvents[], therapistNotes[].
    //
    // Authorised off the SAME allowedUids as the live room, so the two can
    // never disagree. Also provisioned server-side; the client only updates.
    match /sessions/{sessionId} {
      allow get, list: if isSessionMember(sessionId);

      allow create: if false;
      allow delete: if false;

      // Field-level limits. Written from the browser (see frontend/src):
      //   both sides  captions, transcript (useSessionTranscription, CaptionOverlay),
      //               moduleEvents (lib/sessionEvents), whiteboard* (StaadWhiteboard),
      //               their own aiConsent flag (session page)
      //   therapist   therapistNotes (NotesPanel, AINotesPanel/Popup), callPlan
      //               (CallPlanTab)
      // aiInsight, reportStats, sessionId, preview and the rest are written by the
      // server only (Admin SDK). Logs only grow from the browser.
      allow update: if isSessionMember(sessionId)
        && changedKeys().hasOnly(
             isProfessional()
               ? ['aiConsent', 'captions', 'transcript', 'transcriptLastUpdated',
                  'moduleEvents', 'moduleEventsLastUpdated',
                  'whiteboardElements', 'whiteboardUpdatedBy', 'whiteboardUpdatedAt',
                  'therapistNotes', 'therapistNotesLastUpdated', 'callPlan']
               : ['aiConsent', 'captions', 'transcript', 'transcriptLastUpdated',
                  'moduleEvents', 'moduleEventsLastUpdated',
                  'whiteboardElements', 'whiteboardUpdatedBy', 'whiteboardUpdatedAt'])
        && ownConsentOnly()
        && appendOnly('captions')
        && appendOnly('transcript')
        && appendOnly('moduleEvents')
        && appendOnly('therapistNotes');

      // ── rawSessionLog: the session diary ─────────────────────────────────
      // Append-only time series of attention scores (and, once the deferred
      // dual-write lands, transcript entries). Immutable by design: this is
      // clinical observation data, so history must not be rewritten after the
      // fact. Deletion is a server-side retention concern, not a client one.
      match /rawSessionLog/{entryId} {
        allow get, list: if isSessionMember(sessionId);

        allow create: if isSessionMember(sessionId)
          && request.resource.data.keys().hasOnly(['timestamp', 'type', 'value'])
          && request.resource.data.keys().hasAll(['timestamp', 'type', 'value'])
          && request.resource.data.type in ['attention', 'transcript']
          && (
               (request.resource.data.type == 'attention'
                 && request.resource.data.value is int
                 && request.resource.data.value >= 0
                 && request.resource.data.value <= 100)
               ||
               (request.resource.data.type == 'transcript'
                 && request.resource.data.value is string
                 && request.resource.data.value.size() <= 10000)
             );

        allow update, delete: if false;
      }
    }

    // ── moduleStates/{sessionId}_{moduleId} ─────────────────────────────────
    // Shared per-module state. The session id is encoded in the document id,
    // so authorisation derives from the prefix before the first underscore.
    // Session ids are UUIDs (no underscores), so this split is unambiguous
    // regardless of what the module id contains.
    match /moduleStates/{stateId} {
      allow get, list: if isSessionMember(stateId.split('_')[0]);
      // Written only by updateModuleState() (frontend/src/services/sessionSync.ts):
      // { state, updatedBy, updatedAt }, merged. updatedBy is the writer's own
      // uid ('anonymous' when the page has none).
      allow create, update: if isSessionMember(stateId.split('_')[0])
        && request.resource.data.keys().hasOnly(['state', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('state', {}) is map
        && request.resource.data.get('updatedBy', request.auth.uid) in [request.auth.uid, 'anonymous']
        && request.resource.data.get('updatedAt', '') is string
        && request.resource.data.get('updatedAt', '').size() <= 40;
      allow delete: if false;
    }

    // ── patients/{patientUid} ───────────────────────────────────────────────
    // Cross-session per-patient data (currently MicroQuestBoard's quest list).
    // Keyed by the patient's Firebase UID.
    //
    // The patient always has access to their own document. A therapist has
    // access only through a session they share with the patient: every write
    // carries `sessionId`, and the rule checks that the live session's
    // allowedUids (server-provisioned from Postgres) contains BOTH the therapist
    // and the patient. Reads check the session stored on the document. This
    // replaces "any THERAPIST may read and write every patient's document".
    function sharesSessionWith(sid, patientUid) {
      return sid is string && sid.size() > 0
        && liveSessionExists(sid)
        && liveSessionData(sid).keys().hasAny(['allowedUids'])
        && request.auth.uid in liveSessionData(sid).allowedUids
        && patientUid in liveSessionData(sid).allowedUids;
    }

    match /patients/{patientUid} {
      allow get: if signedIn() && (
        request.auth.uid == patientUid
        // A missing document reveals nothing; lets the therapist's first
        // load succeed before anything has been saved.
        || resource == null
        || (isProfessional()
            && sharesSessionWith(resource.data.get('sessionId', ''), patientUid))
      );
      allow list: if false;
      allow create, update: if signedIn() && (
        request.auth.uid == patientUid
        || (isProfessional()
            && sharesSessionWith(request.resource.data.get('sessionId', ''), patientUid))
      );
      allow delete: if false;
    }

    // ── Default deny ────────────────────────────────────────────────────────
    // Anything not matched above is refused. This replaces the permissive
    // catch-all. A NEW collection added in code will be denied until a rule is
    // written for it here — that is deliberate: fail closed, not open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
